{
  "name": "webgpu-we3d",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "description": "WE3D - WebGPU Engine 3D rendering engine",
  "main": "dist/we3d.cjs",
  "module": "dist/we3d.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/we3d.mjs",
      "require": "./dist/we3d.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "rm -rf dist && vite build --config vite.config.lib.ts && tsc -p tsconfig.lib.json",
    "preview": "vite preview",
    "examples:generate": "node scripts/generate-examples-json.mjs",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "keywords": [
    "webgpu",
    "3d",
    "rendering-engine",
    "pbr",
    "gltf",
    "atmosphere",
    "shadow",
    "animation"
  ],
  "author": "quzongwen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WebgpuEngine/WE3D"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/seedrandom": "^3.0.8",
    "@types/stats.js": "^0.17.4",
    "@webgpu/types": "^0.1.70",
    "hash-wasm": "^4.12.0",
    "lil-gui": "^0.17.0",
    "muigui": "^0.0.22",
    "playwright": "^1.62.1",
    "rollup": "^4.48.1",
    "seedrandom": "^3.0.5",
    "stats.js": "^0.17.0",
    "ts-jest": "^29.4.1",
    "typedoc": "^0.28.11",
    "typescript": "~5.8.3",
    "vite": "^7.1.2",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0"
  },
  "dependencies": {
    "@loaders.gl/compression": "4.3.4",
    "@loaders.gl/core": "4.3.4",
    "@loaders.gl/draco": "4.3.4",
    "@loaders.gl/gltf": "4.3.4",
    "@loaders.gl/json": "4.3.4",
    "@loaders.gl/obj": "4.3.4",
    "@loaders.gl/textures": "4.3.4",
    "@loaders.gl/video": "4.3.4",
    "@loaders.gl/zip": "4.3.4",
    "hdrify": "^0.12.1",
    "js-md5": "^0.8.3",
    "ktx-parse": "^1.1.0",
    "webgpu-utils": "^1.11.0",
    "wgpu-matrix": "^3.4.0"
  }
}
